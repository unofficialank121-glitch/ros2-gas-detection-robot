<?xml version="1.0"?>

<robot name="gas_robot">

  <!-- ================= BASE ================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <box size="0.6 0.4 0.3"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <box size="0.6 0.4 0.3"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.25"/>
      <mass value="5.0"/>
      <inertia
        ixx="0.10417"
        ixy="0.0"
        ixz="0.0"
        iyy="0.18750"
        iyz="0.0"
        izz="0.21667"/>
    </inertial>

  </link>


  <!-- ================= LEFT DRIVE WHEEL ================= -->

  <link name="left_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>

      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.00146"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00250"
        iyz="0.0"
        izz="0.00146"/>
    </inertial>

  </link>


  <joint name="left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 0.23 0.10"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ================= RIGHT DRIVE WHEEL ================= -->

  <link name="right_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>

      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.00146"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00250"
        iyz="0.0"
        izz="0.00146"/>
    </inertial>

  </link>


  <joint name="right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="0 -0.23 0.10"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ================= LEFT REAR SUPPORT WHEEL ================= -->

  <link name="left_support_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>

      <surface>
        <friction>
          <ode>
            <mu>0.3</mu>
            <mu2>0.3</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

    <inertial>
      <mass value="0.15"/>
      <inertia
        ixx="0.0002"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0003"
        iyz="0.0"
        izz="0.0002"/>
    </inertial>

  </link>


  <joint name="left_support_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_support_wheel"/>

    <!-- rear of robot -->
    <origin xyz="-0.22 0.15 0.05"/>

    <axis xyz="0 1 0"/>

    <dynamics
      damping="0.05"
      friction="0.01"/>

  </joint>


  <!-- ================= RIGHT REAR SUPPORT WHEEL ================= -->

  <link name="right_support_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>

      <surface>
        <friction>
          <ode>
            <mu>0.3</mu>
            <mu2>0.3</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

    <inertial>
      <mass value="0.15"/>
      <inertia
        ixx="0.0002"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0003"
        iyz="0.0"
        izz="0.0002"/>
    </inertial>

  </link>


  <joint name="right_support_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_support_wheel"/>

    <!-- rear of robot -->
    <origin xyz="-0.22 -0.15 0.05"/>

    <axis xyz="0 1 0"/>

    <dynamics
      damping="0.05"
      friction="0.01"/>

  </joint>


  <!-- ================= GAS SENSOR ================= -->

  <link name="gas_sensor">

    <visual>
      <geometry>
        <box size="0.15 0.15 0.1"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <box size="0.15 0.15 0.1"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>

  </link>


  <joint name="gas_sensor_joint" type="fixed">

    <parent link="base_link"/>
    <child link="gas_sensor"/>

    <origin xyz="0 0 0.40"/>

  </joint>


  <!-- ================= DIFFERENTIAL DRIVE ================= -->

  <gazebo>

    <plugin
      name="diff_drive"
      filename="libgazebo_ros_diff_drive.so">

      <ros>
        <namespace>/</namespace>
      </ros>

      <update_rate>50</update_rate>

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.46</wheel_separation>
      <wheel_diameter>0.20</wheel_diameter>

      <max_wheel_torque>1.0</max_wheel_torque>
      <max_wheel_acceleration>0.5</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>

    </plugin>

  </gazebo>

</robot>